# Copy to .env and adjust. Everything here has a free/local default already.

# Postgres (docker-compose provisions this automatically)
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
DATABASE_URL=postgresql://gateway:gateway@postgres:5432/gateway

REDIS_URL=redis://redis:6379/0

# PROVIDER selects the serving backend: "ollama" (default) or "vllm".
PROVIDER=ollama

# Ollama (https://ollama.com) -- free, runs open-weight models locally on
# CPU, zero GPU required. The default backend.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# vLLM (https://github.com/vllm-project/vllm) -- an OpenAI-compatible
# serving engine, used when PROVIDER=vllm. Needs a CUDA GPU. Point this at
# `vllm serve <model>` or the optional `vllm` docker-compose service
# (`docker compose --profile vllm up`). VLLM_API_KEY is only needed if the
# server was started with `--api-key`.
VLLM_BASE_URL=http://localhost:8001
VLLM_API_KEY=

DEFAULT_MODEL=llama3

# Used to create/revoke gateway API keys via POST /v1/admin/keys.
ADMIN_KEY=change-me-admin-key

MOCK_MODE=false

# If the backend is unreachable or errors: true = answer with a canned mock
# response (handy for a zero-setup demo), false = return HTTP 502. Keep it
# false whenever you're measuring anything, or a crashed backend will look
# like a very fast one.
MOCK_FALLBACK=true
